# PostgreSQL
POSTGRES_USER=argowei
POSTGRES_PASSWORD=argowei
POSTGRES_DB=argowei
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Address the API listens on (default 0.0.0.0:8000)
# ARGOWEI_BIND_ADDRESS=0.0.0.0:8000

# Authentication
# Set to true when the dashboard is served over HTTPS.
ARGOWEI_COOKIE_SECURE=false
ARGOWEI_SESSION_TTL_HOURS=24

# Scheduled ARP discovery (needs CAP_NET_RAW; empty list = disabled)
ARGOWEI_DISCOVERY_INTERFACES=
ARGOWEI_DISCOVERY_INTERVAL_SECS=300
ARGOWEI_DISCOVERY_TIMEOUT_SECS=3
ARGOWEI_OFFLINE_AFTER_MISSED_SCANS=3
ARGOWEI_OFFLINE_AFTER_SECS=900

# Seconds after an interface's first scan during which new devices are learned
# silently (no alert). 0 = only the first scan.
ARGOWEI_BASELINE_WINDOW_SECS=0

# Device names: which sources to ask (dhcp, mdns, netbios, rdns; empty = off)
ARGOWEI_HOSTNAME_SOURCES=dhcp,mdns,netbios,rdns
# DNS server for reverse lookups, e.g. your router. Default: the local servers
# listed in /etc/resolv.conf.
# ARGOWEI_DNS_SERVER=192.168.178.1
# dnsmasq lease file for the DHCP source
# ARGOWEI_DHCP_LEASES_FILE=/var/lib/misc/dnsmasq.leases
ARGOWEI_HOSTNAME_TIMEOUT_MS=1000
ARGOWEI_HOSTNAME_REFRESH_SECS=3600
ARGOWEI_HOSTNAME_CONCURRENCY=16
